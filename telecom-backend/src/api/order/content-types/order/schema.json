{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "order_number": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "customer_email": {
      "type": "email",
      "required": false
    },
    "products": {
      "type": "json",
      "required": true
    },
    "total_amount": {
      "type": "decimal",
      "required": true
    },
    "payment_status": {
      "type": "enumeration",
      "required": true,
      "default": "unpaid",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ]
    },
    "order_status": {
      "type": "enumeration",
      "required": true,
      "default": "pending",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ]
    }
  }
}
